# Copy to .env and fill in real values. Never commit .env.

# Public hostname Traefik routes to this app, e.g. einkauf.example.com
APP_HOST=einkauf.example.com

# Superuser for the admin UI (/_/). Created or updated on every container start.
PB_ADMIN_EMAIL=admin@example.com
PB_ADMIN_PASSWORD=change-me-to-a-long-password

# Encrypts the app settings stored in the database. Must be exactly 32 characters.
# Generate one with: openssl rand -hex 16
PB_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef
